# --- Database (Turso / libSQL) ---
# Leave TURSO_DATABASE_URL empty for local dev: a local file DB (orders.db) is used.
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-token

# --- Admin panel password (for /admin) ---
ADMIN_PASSWORD=change-me-strong-password

# --- Order notification email (Gmail SMTP works with an App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourmail@gmail.com
SMTP_PASS=your-gmail-app-password
ORDER_NOTIFY_EMAIL=yourmail@gmail.com

# --- WhatsApp button (country code + number, digits only) ---
NEXT_PUBLIC_WHATSAPP_NUMBER=923258774221
